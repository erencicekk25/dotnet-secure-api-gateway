# -----------------------------------------------------------------------------
# Environment template for docker-compose.yml
#   1. cp .env.example .env
#   2. Replace EVERY value below (e.g. `openssl rand -base64 48`)
#   3. Never commit .env  (it is listed in .gitignore)
# -----------------------------------------------------------------------------

# PostgreSQL password for the security audit database (security_events, http_logs)
POSTGRES_PASSWORD=replace-with-a-local-postgres-password

# Redis password (AUTH) for the distributed rate limiter
REDIS_PASSWORD=replace-with-a-local-redis-password

# HS256 signing key for JWT validation - at least 32 characters
JWT_SIGNING_KEY=replace-with-a-random-string-of-at-least-32-characters

# ASP.NET Core environment of the gateway container (Development | Staging | Production)
GATEWAY_ENVIRONMENT=Staging

# Exposes POST /auth/dev-token for demos. Always disabled when GATEWAY_ENVIRONMENT=Production.
DEV_TOKEN_ISSUER_ENABLED=true

# Behaviour when Redis is unreachable: true = let traffic through, false = reject with 503
RATE_LIMIT_FAIL_OPEN=true
