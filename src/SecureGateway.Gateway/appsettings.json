{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Yarp": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Logging": {
    "Database": {
      "Enabled": true
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Redis": "",
    "SecurityAudit": ""
  },

  "Jwt": {
    "Issuer": "secure-gateway",
    "Audience": "banking-services",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 15,
    "ClockSkewSeconds": 30
  },

  "DevTokenIssuer": {
    "Enabled": false
  },

  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },

  "SecurityAudit": {
    "ChannelCapacity": 10000,
    "BatchSize": 250,
    "FlushIntervalMilliseconds": 1000,
    "InitializationRetrySeconds": 5
  },

  "RateLimiting": {
    "Enabled": true,
    "KeyPrefix": "gw:rl",
    "DefaultPolicy": "default",
    "FailOpen": true,
    "Policies": [
      { "Name": "default",                 "PartitionBy": "ClientIp", "PermitLimit": 100,  "WindowSeconds": 60 },
      { "Name": "public-ip",               "PartitionBy": "ClientIp", "PermitLimit": 30,   "WindowSeconds": 60 },
      { "Name": "auth-ip",                 "PartitionBy": "ClientIp", "PermitLimit": 5,    "WindowSeconds": 60 },
      { "Name": "accounts-per-user",       "PartitionBy": "User",     "PermitLimit": 60,   "WindowSeconds": 60 },
      { "Name": "payments-per-user",       "PartitionBy": "User",     "PermitLimit": 10,   "WindowSeconds": 60 },
      { "Name": "payments-endpoint-guard", "PartitionBy": "Endpoint", "PermitLimit": 1000, "WindowSeconds": 60 },
      { "Name": "audit-per-user",          "PartitionBy": "User",     "PermitLimit": 30,   "WindowSeconds": 60 }
    ]
  },

  "ReverseProxy": {
    "Routes": {
      "accounts-route": {
        "ClusterId": "accounts",
        "AuthorizationPolicy": "AccountsRead",
        "Match": { "Path": "/api/accounts/{**catch-all}" },
        "Metadata": { "RateLimitPolicies": "accounts-per-user" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "fx-rates-route": {
        "ClusterId": "accounts",
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/api/public/fx-rates", "Methods": [ "GET" ] },
        "Metadata": { "RateLimitPolicies": "public-ip" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "payments-route": {
        "ClusterId": "payments",
        "AuthorizationPolicy": "PaymentsWrite",
        "Match": { "Path": "/api/payments/{**catch-all}" },
        "Metadata": { "RateLimitPolicies": "payments-per-user,payments-endpoint-guard" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      }
    },
    "Clusters": {
      "accounts": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "HealthCheck": {
          "Active": { "Enabled": true, "Interval": "00:00:15", "Timeout": "00:00:05", "Policy": "ConsecutiveFailures", "Path": "/health" }
        },
        "Destinations": {
          "primary": { "Address": "http://localhost:5101/" }
        }
      },
      "payments": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "HealthCheck": {
          "Active": { "Enabled": true, "Interval": "00:00:15", "Timeout": "00:00:05", "Policy": "ConsecutiveFailures", "Path": "/health" }
        },
        "Destinations": {
          "primary": { "Address": "http://localhost:5102/" }
        }
      }
    }
  }
}
